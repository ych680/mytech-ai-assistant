# Shared local template: copy only when .env does not already exist.
# Empty credential/binding values are placeholders, not usable credentials.
# Never paste real values into this tracked file. See docs/local-workspace.md.

# Historical v2 only (27 products). Preserve its independent application binding.
PORT=8787
FASTGPT_API_KEY=
FASTGPT_API_URL=
FASTGPT_APP_ID=

# v2.1 TEST only (54 products). No fallback to FASTGPT_* or PORT.
# URL: full HTTPS chat-completions endpoint, without userinfo/query/fragment.
# Binding: choose app-key or app-id after verifying the intended TEST application.
# In app-key mode leave APP_ID empty; in app-id mode supply the TEST APP_ID.
# Leave all four binding fields empty for offline assets-only startup.
MYTECH_TEST_FASTGPT_API_URL=
MYTECH_TEST_FASTGPT_API_KEY=
MYTECH_TEST_FASTGPT_BINDING=
MYTECH_TEST_FASTGPT_APP_ID=
MYTECH_TEST_PORT=8788
MYTECH_TEST_REQUEST_TIMEOUT_MS=120000
MYTECH_TEST_MAX_TOKENS=4096
MYTECH_TEST_TIMINGS=0
